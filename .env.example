# Copiez ce fichier en ".env" (en local) ou saisissez ces valeurs chez votre hébergeur.

# Obligatoire : votre clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Obligatoire pour entraîner l'assistant : code d'accès à la page /admin.
# Sans ce code, la page d'administration reste fermée.
ADMIN_CODE=choisissez-un-code-solide

# Laissez vide pour un accueil ouvert à tous les visiteurs.
# Renseignez-le pour réserver l'assistant à ceux qui connaissent le code.
ACCESS_CODE=

# Protège votre crédit : nombre maximal de questions par jour pour tout le site.
MAX_DAILY_QUESTIONS=500
RATE_LIMIT_PER_MIN=12

# Optionnel
CLAUDE_MODEL=claude-sonnet-5-5
MAX_TOKENS=600
